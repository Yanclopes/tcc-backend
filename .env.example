# =========================================================================
# Aplicacao
# =========================================================================
NODE_ENV=development
PORT=3000
# Prefixo global das rotas REST (ex.: /api/v1/goals)
API_PREFIX=api/v1
# Origens liberadas no CORS (separadas por virgula). Use * apenas em dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =========================================================================
# Banco de dados (PostgreSQL)
# =========================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ods
DB_PASSWORD=ods_secret
DB_DATABASE=ods_quiz
# Nunca use synchronize=true em producao; migrations sao a fonte da verdade.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# =========================================================================
# Redis (estado do jogo em tempo real)
# =========================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Tempo de vida (segundos) do estado de uma partida no Redis.
GAME_SESSION_TTL=7200

# =========================================================================
# Autenticacao (JWT - RFC 7519)
# =========================================================================
JWT_SECRET=troque-este-segredo-por-um-valor-forte-e-aleatorio
JWT_EXPIRES_IN=1d

# =========================================================================
# Regras do jogo
# =========================================================================
# Quantidade de ajudas (power-ups) concedidas no inicio de cada partida.
GAME_DEFAULT_POWERUPS=3

# =========================================================================
# Administrador inicial (criado pela seed)
# =========================================================================
ADMIN_EMAIL=admin@ods.local
ADMIN_PASSWORD=troque-esta-senha-de-admin
