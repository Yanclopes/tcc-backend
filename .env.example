# =========================================================================
# Aplicacao
# =========================================================================
NODE_ENV=development
PORT=3000
# Prefixo global das rotas REST (ex.: /api/v1/goals)
API_PREFIX=api/v1
# Origens liberadas no CORS (separadas por virgula). Use * apenas em dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =========================================================================
# Banco de dados (PostgreSQL)
# =========================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ods
DB_PASSWORD=ods_secret
DB_DATABASE=ods_quiz
# Nunca use synchronize=true em producao; migrations sao a fonte da verdade.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# =========================================================================
# Redis (estado do jogo em tempo real)
# =========================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Tempo de vida (segundos) do estado de uma partida no Redis.
GAME_SESSION_TTL=7200

# =========================================================================
# Autenticacao (JWT - RFC 7519)
# =========================================================================
JWT_SECRET=troque-este-segredo-por-um-valor-forte-e-aleatorio
JWT_EXPIRES_IN=1d

# =========================================================================
# Regras do jogo
# =========================================================================
# Quantidade de ajudas (power-ups) concedidas no inicio de cada partida.
GAME_DEFAULT_POWERUPS=3

# =========================================================================
# Administrador inicial (criado pela seed)
# =========================================================================
ADMIN_EMAIL=admin@ods.local
ADMIN_PASSWORD=troque-esta-senha-de-admin

# =========================================================================
# Chat com IA — assistente de analise (RAG + function calling)
# Ver .specs/06-chat-ia.md
# =========================================================================
# Chave da OpenAI. Sem ela o modulo sobe DESABILITADO: as rotas /chat
# respondem 503 e o resto da plataforma segue funcionando normalmente.
# NUNCA exponha esta chave ao front-end.
OPENAI_API_KEY=
# Modelo de conversa.
OPENAI_MODEL_CHAT=gpt-4o-mini
# Modelo de embedding. Trocar exige reindexar tudo (npm run chat:indexar),
# e se a dimensao mudar a coluna vector(N) da migration tambem muda.
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Quantos trechos a busca vetorial devolve por pergunta.
CHAT_RAG_TOP_K=6
# Teto de voltas no laco modelo <-> ferramenta (evita loop queimando cota).
CHAT_MAX_PASSOS=6
# Mensagens por minuto por usuario.
CHAT_RATE_LIMIT=10

# Versao vigente do termo de privacidade (LGPD). Ao muda-la, todo usuario e
# obrigado a reconsentir no proximo acesso. Precisa bater com o valor exibido em
# tcc-frontend/src/pages/PrivacyPage.tsx.
PRIVACY_VERSION=2026-08-v2
